source ~/.bashrc

TTY=$(tty)
export EDITOR=em
export GPG_TTY="${TTY}"

while read -r l; do eval export $l ; done < <(/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator)

[ "${TTY}" = "/dev/tty1" ] && uwsm check may-start && exec systemd-cat -t uwsm_start uwsm start default
