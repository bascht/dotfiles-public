#!/usr/bin/env bash

declare name
raw_name=$(basename $(realpath $(pwd)/../))/$(basename $PWD)
name="${raw_name//./_}"

source ~/.config/bash/aliases.sh

emacs_name=" ${name}"
git fetch -a && git rebase
kitten @ set-window-title "${emacs_name}"
kitten @ send-text -- emacsclient -s comacs --tty -e "'(bascht--switch-to-or-load-perspective \"${name}\" \"${PWD}\")'\n"

kitten @ launch --type=tab --dont-take-focus --cwd=current --hold -- eza --long --header --git --no-user --no-permissions --no-time --no-filesize --icons --recurse --tree --level 1
