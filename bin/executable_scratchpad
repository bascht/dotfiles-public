#!/usr/bin/env bash
set -eo pipefail

TMUX_SESSION="Scratch"

if tmux list-sessions | grep "$TMUX_SESSION" >/dev/null; then
    TMUX_CMD="tmux a -t ${TMUX_SESSION}"
else
    TMUX_CMD="tmux new-session -s ${TMUX_SESSION}"
fi

if ! swaymsg -t get_tree | grep "terminal_scratchpad" >/dev/null; then
    swaymsg exec -- foot --config=$HOME/.config/foot/foot-scratchpad.ini --app-id terminal_scratchpad ${TMUX_CMD}
fi

exec swaymsg --quiet "[app_id=terminal_scratchpad]" scratchpad show
