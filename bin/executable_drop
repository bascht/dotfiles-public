#!/usr/bin/env bb

(require '[babashka.fs :as fs])
(require '[babashka.process :refer [shell process]])

(def file (first *command-line-args*))
(def filename (fs/file-name file))
(def extension (fs/extension file))
(def new-name (str (->> "openssl rand -hex 12" (shell {:out :string}) :out clojure.string/trim) "." extension))

(def upload ["scp" file (format "drop.bascht.space:/home/bascht/drop/%s" new-name)])
(def url (format "https://drop.bascht.space/%s" new-name))

(if-not (fs/exists? file)
  (do (println (str "ERROR: File does not exist: " file))
      (System/exit 1)))

(println (format "Will upload file %s to %s" new-name upload))

(println upload)
(println "ohai")
(try (shell upload)
     (catch Exception e
       (println "This didn't work:" (.getMessage e))))


(shell "wl-copy" url)
(shell "notify-send" "--expire-time=1000" (str "--icon=" file) "Uploaded successfully" url)
