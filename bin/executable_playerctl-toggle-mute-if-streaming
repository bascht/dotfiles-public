#!/usr/bin/env bb

(require '[babashka.process :refer [shell]])
(require '[clojure.string :as str])
(require '[babashka.fs :as fs])

(defn playerctl [args] (-> (apply shell {:out :string} "/usr/bin/playerctl" args) :out str/split-lines))
(defn players [] (playerctl ["--list-all"]))
(defn set-volume [player volume] (playerctl ["-p" player "volume" volume]))

(def player (some #{"Supersonic" "mopidy" "mpvl" "mpd"} (players)))
(def volume-state (format "%s/playerctl-last-volume" (System/getenv "XDG_RUNTIME_DIR")))

(when-not (fs/regular-file? volume-state)
  (fs/create-file volume-state))

(def old-volume (str/trim-newline(slurp volume-state)))
(def volume (first (playerctl ["-p" player "volume"])))
(def is-playing? (= (playerctl ["-p" player "status"]) ["Playing"]))
(def is-muted? (= (playerctl ["-p" player "volume"]) ["0.000000"]))
(def metadata (playerctl ["-p" player "metadata"]))
(def is-streaming? (and (= "Supersonic" player)(some #(str/includes? % "xesam:url") (playerctl ["-p" player "metadata"]))))


(if (nil? player)
  (playerctl "play-pause")
  (if (and is-playing? is-muted?)
    (set-volume player old-volume)
    (when (and is-playing? is-streaming?)
      (spit volume-state volume)
      (set-volume player 0))))
