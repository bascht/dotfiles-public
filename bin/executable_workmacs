#!/usr/bin/env bb

(require '[babashka.process :refer [exec]])

(let [workmacs ["emacsclient" "-s" "workmacs" "--create-frame"]
      first (first *command-line-args*)
      second (second *command-line-args*)]

  (if (= "eval" first)
    (apply exec (flatten [workmacs "--eval" second]))
    (apply exec (flatten [workmacs "--no-wait" (flatten *command-line-args*)]))))
