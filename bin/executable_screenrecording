#!/usr/bin/env bb

(require '[babashka.cli :as cli]
         '[babashka.process :refer [shell process destroy]] )

(defn slurp-geometry [] (-> (shell {:out :string :err :nil} "slurp") :out str/trim))

(def now (java.time.LocalDateTime/now))
(def default-name (let [formatter (java.time.format.DateTimeFormatter/ofPattern "yyyy-MM-dd-HHmmss")]
                    (str (.format now formatter) ".mp4")))
(def default-directory (let [formatter (java.time.format.DateTimeFormatter/ofPattern "yyyy-MM")
                             path (fs/path (fs/expand-home "~/Videos/Screenrecordings") (.format now formatter))]
                         (str path)))

(def options (cli/parse-opts *command-line-args* {:spec {:dir {:default default-directory :validate fs/directory?}
                                                         :geometry {:coerce :string} }
                                                  :args->opts [:name]
                                                  :exec-args {:name default-name}}))

(def target-file (str (fs/path (:dir options) (:name options))))
(def geometry (or (:geometry options) (slurp-geometry)))

(def recorder (process "wf-recorder" "-g" geometry "-f" target-file))

(let [stop-and-save (-> (shell {:continue true} "gum" "confirm" (str "Recording to " target-file) "--affirmative=Stop recording" "--negative=Abort recording") :exit zero?)]
  (destroy recorder)
  (if stop-and-save
    (println target-file)
    (fs/delete target-file)))
