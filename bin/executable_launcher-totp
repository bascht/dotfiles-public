#!/usr/bin/env bash

set -o errexit

# Select a password from the gopass store,copy it to current primary clipboard,
# send the current terminal window to the scratch space & clear the clipboard
# afterwards.

if [ -z "$QUERY" ]; then
    QUERY=''
fi

# Work around my inability to correctly name the things on my Yubikey :joy:
case "${QUERY}" in
    aws*) QUERY="aws" ;;
    *otc*) QUERY="otc" ;;
esac

list=$(ykman oath accounts list)
account=$(echo -e "${list}" | fzf -q "$QUERY")
TOKEN=$(ykman oath accounts code "${account}" | awk '{ print $2 }')
swaymsg exec -- wtype -d 150 "${TOKEN}"
