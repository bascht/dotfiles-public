#!/usr/bin/env bash

FOLDER=$(zoxide query --list |fzf --preview "git -C {} status" --preview-window="bottom")
raw_name=$(basename $(realpath $FOLDER/../))/$(basename $FOLDER)
name="${raw_name//./_}"
kitty_name="kitty.${name}"

if [ -n "${FOLDER}" ]; then
  existing_kitty=$(niri msg --json windows | jq '.[]|select(.app_id=="'${kitty_name}'").id')
  if [ -n "${existing_kitty}" ]; then
    niri msg action focus-window --id "${existing_kitty}"
  else
    niri msg action spawn -- emacsclient -s comacs --create-frame -e "(bascht--load-project \"${FOLDER}\")"
    niri msg action spawn -- kitty --app-id "kitty_project_${name}" --directory "${FOLDER}" --hold "/home/bascht/bin/tn"
#    niri msg action set-column-display tabbed
  fi
fi
