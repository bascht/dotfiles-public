#!/usr/bin/env bash

FOLDER=$(zoxide query --list |fzf --preview "git -C {} status" --preview-window="bottom")
raw_name=$(basename $(realpath $FOLDER/../))/$(basename $FOLDER)
name="${raw_name//./_}"

if [ -n "${FOLDER}" ]; then
  niri msg action spawn -- kitty --class "kitty-${name}" --directory "${FOLDER}" --hold "/home/bascht/bin/tn"
fi
