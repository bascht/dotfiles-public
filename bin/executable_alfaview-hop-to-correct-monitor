#!/usr/bin/env bash

ALFAVIEW_ID="$(alfaview-get-window-id)"
IS_FLOATING="$(niri msg --json windows | jq '.[] | select(.id == '${ALFAVIEW_ID}').is_floating')"
CURRENT_WORKSPACE=$(niri msg --json workspaces | jq '.[]|select(.is_focused==true and .is_active==true).id')

niri msg action focus-window --id "${ALFAVIEW_ID}"

if [[ "${IS_FLOATING}" == "true" ]]; then
  niri msg action move-window-to-workspace --focus false --window-id ${ALFAVIEW_ID} comms
  niri msg action toggle-window-floating --id "${ALFAVIEW_ID}"
  niri msg action set-window-width --id "${ALFAVIEW_ID}" 300
else
  niri msg action toggle-window-floating --id "${ALFAVIEW_ID}"
  niri msg action move-window-to-workspace --window-id ${ALFAVIEW_ID} "${CURRENT_WORKSPACE}"
  niri msg action focus-window --id "${ALFAVIEW_ID}"
fi;
