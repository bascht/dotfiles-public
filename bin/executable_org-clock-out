#!/usr/bin/env bash

REASON="${1:-Clocking out from current task}"

if [[ $(emacsclient -s workmacs -n -e "(org-clocking-p)") == "t" ]]; then
    emacsclient -s workmacs -n -e "(org-clock-out)"
else
    REASON="Nothing to clock out from."
fi

notify-send "OrgMode $(date +%H:%m) $(org-get-current-clock-task)" "${REASON}"
