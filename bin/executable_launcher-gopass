#!/usr/bin/env bash

set -o errexit

# Select a password from the gopass store,copy it to current primary clipboard,
# send the current terminal window to the scratch space & clear the clipboard
# afterwards.

QUERY=$1

if [ -z "$QUERY" ]; then
  gopass list -f | fzf -q "$QUERY" --bind "alt-t:become(launcher-gopass {} type),alt-p:become(launcher-gopass {} type password),alt-u:become(launcher-gopass {} type user),enter:become(launcher-gopass {})"
  exit 0
fi

niri msg action set-window-height 75
niri msg action set-window-width 372
niri msg action center-window
niri msg action move-floating-window -y 10

password=$(gum spin --spinner="points" --title="Getting password" -- gopass show -o "${QUERY}")

if [[ "${2}" == "type" ]]; then
  niri msg action focus-window-previous
  if [[ "${3}" == "password" ]]; then
    gum spin --spinner="monkey" --title="Typing ${3}…" -- wtype -s 200 -d 20 "${password}"
  elif [[ "${3}" != "" ]]; then
     gum spin --spinner="monkey" --title="Typing ${3}…" -- wtype -s 200 -d 20 "$(gopass show "${QUERY}" "${3}")"
   else
     gum spin --spinner="monkey" --title="Typing happening…" -- wtype -s 200 -d 20 "$(gopass show "${QUERY}" user)" -s 50 -k tab -s 100 "${password}"
   fi
else
  niri msg action focus-tiling
  echo "${password}" | wl-copy
  clear
  gum spin --spinner="monkey" --title="Clearing clipboard in 5 seconds" sleep 5

  cliphist delete-query "${password}"
  wl-copy --clear
  notify-send "gopass" "Cleared clipboard" -t 1000 --icon=dialog-password
fi;
