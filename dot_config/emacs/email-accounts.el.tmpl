{{ if hasKey . "mail" -}}
;;; email-accounts --- my mu4e accounts for this computer
;;; Commentary:
;;; Code:
(setq mu4e-contexts `(
{{ range .mail.accounts -}}
           ,(make-mu4e-context
               :name "{{.name}}"
               :enter-func (lambda () (mu4e-message "Entering {{.name}} context"))
               :leave-func (lambda () (mu4e-message "Leaving {{.name}} context"))
               :match-func (lambda (msg)
                             (when msg
                               (string-match-p "^/{{.name}}" (mu4e-message-field msg :maildir))))
               :vars '((user-mail-address	 . "{{.email_address }}")
                       (user-full-name     . "{{.full_name}}")
                       (mu4e-sent-folder   . "/{{.name}}/{{.sent_folder}}")
                       (mu4e-refile-folder . "/{{.name}}/Archiv/{{now.Year}}")
                       (mu4e-drafts-folder . "/{{.name}}/{{.drafts_folder}}")
                       (mu4e-trash-folder  . "/{{.name}}/{{.trash_folder}}")
                       (message-user-organization . "{{.name}}")))
{{ end}}))

{{ if hasKey .mail "bookmarks" -}}
(setq mu4e-bookmarks '(
{{- range .mail.bookmarks }}
  (:name  {{ .name | quote }} :query {{ .query | quote}} :key ?{{ .key }})
{{- end }}
))
{{ end }}
(provide 'email-accounts)
;;; email-accounts.el ends here
{{- end}}
