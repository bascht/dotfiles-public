[Install]
WantedBy=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/emacs --fg-daemon=comacs
ExecStop=/usr/bin/emacsclient -s comacs --no-wait --eval '(progn (setq kill-emacs-hook nil) (kill emacs))'
Restart=on-failure
Environment=COLORTERM=truecolor
Environment=DOOMPROFILE=comacs

[Unit]
Description=Emacs comacs daemon
After=graphical-session-pre.target
PartOf=graphical-session.target
X-RestartIfChanged=false
