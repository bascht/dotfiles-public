#!/usr/bin/env bash

if [ -n "$CI" ]; then
    echo "Not running this step in CI for now"
    exit 0
fi
## (save-excursion (search-forward "ADD=")(forward-line)(surround-mark "(")(call-interactively 'sort-lines)(save-buffer))
readarray -t ADD < ~/.config/packages/required.txt

REMOVE=(
    firefox
)

LOG=$(mktemp)
yay --sync
yay -S --needed --noconfirm "${ADD[@]}"
exit 0
for PACKAGE in "${ADD[@]}"; do
    if ! yay -Qs "^${PACKAGE}$" >/dev/null; then
        echo "Installing: ${PACKAGE}"
        if ! yay -S --noconfirm "${PACKAGE}" >>"${LOG}"; then
            echo "Failed to install ${PACKAGE}"
        fi
    else
        echo "Already installed: ${PACKAGE}"
    fi
done
